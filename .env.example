# ─── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# platform.openai.com → API Keys
OPENAI_API_KEY=

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# console.upstash.com → base de datos → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Resend (alertas de precio por email) ────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=

# ─── Seguridad interna ────────────────────────────────────────────────────────
# String aleatorio largo — protege el endpoint de cron
# Generá con: openssl rand -hex 32
CRON_SECRET=
# El panel /admin ya no usa un secreto compartido — login real con Supabase
# Auth + profiles.role = 'admin' (ver migración 016_admin_role.sql).

# ─── MercadoLibre (Fase 2+) ───────────────────────────────────────────────────
# developers.mercadolibre.com.ar → Mis Apps
ML_APP_ID=
ML_CLIENT_SECRET=
