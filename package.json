{
  "name": "techsearch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ml-fetch": "tsx --env-file=.env.local scripts/fetchFromML.ts",
    "sync-ml": "tsx --env-file=.env.local scripts/syncFromML.ts",
    "embed": "tsx --env-file=.env.local scripts/generateEmbeddings.ts",
    "embed:all": "tsx --env-file=.env.local scripts/generateEmbeddings.ts regenerate-all",
    "sync": "tsx --env-file=.env.local scripts/sync.ts",
    "sync:frave": "tsx --env-file=.env.local scripts/syncFraveOnly.ts",
    "analyze": "tsx --env-file=.env.local scripts/analyzeProducts.ts",
    "analyze:all": "tsx --env-file=.env.local scripts/analyzeProducts.ts --all",
    "playwright:install": "npx playwright install chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.0",
    "next": "14.2.35",
    "openai": "^6.42.0",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
